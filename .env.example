# .env.example — 복사해서 .env 로 만들고 값을 채운다.
#   config.py 가 읽는 키는 여기 전부 있어야 한다 — 하나라도 빠지면 기동 시 죽는다.

# ── 이 서버 (FastAPI) — 외부에 노출되는 게이트웨이
HOST=0.0.0.0
PORT=19000

# ── MariaDB — 처리 상태 조회 (t_video_file). agent-stt 와 같은 DB
RDB_HOST=127.0.0.1
RDB_PORT=3306
RDB_USER=mydb
RDB_PW=mydb
RDB_NAME=mydb


# ── 뒷단 upstream — nginx 의 upstream 블록처럼 서버를 JSON 배열로 나열한다.
#    여러 대면 순서대로 분산(라운드로빈)한다.
#      예) STT_UPSTREAM=["http://10.0.0.1:19010", "http://10.0.0.2:19010"]

# ① agent-stt (자막 공정 오케스트레이터)
STT_UPSTREAM=["http://127.0.0.1:19010"]

# ② agent-compose (질의 기반 하이라이트 편성) — agent-compose/.env 의 APP_PORT
COMPOSE_UPSTREAM=["http://127.0.0.1:8084"]

